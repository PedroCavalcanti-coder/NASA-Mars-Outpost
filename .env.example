# Copie para .env (o .env real NUNCA vai para o GitHub)

# Servidor (API + Socket.IO)
PORT=3001

# Origem(ns) do site, separadas por vírgula (CORS + Origin das requisições)
WEB_ORIGIN=http://localhost:5173

# Segredo-mestre: dele saem as chaves que criptografam o token, protegem os refresh tokens e
# "temperam" as senhas. Mínimo de 32 caracteres. Gere um com: npm run secret:jwt
# ATENÇÃO: trocar este valor derruba todas as sessões e invalida todas as senhas já cadastradas.
JWT_SECRET=

# PostgreSQL (Neon): postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Opcional ------------------------------------------------------------
# Atrás de proxy/CDN (Render, Fly, Railway...): true para ler o IP real em X-Forwarded-For
# TRUST_PROXY=false
# lax (padrão) | strict | none (só se site e API estiverem em domínios diferentes; exige HTTPS)
# COOKIE_SAMESITE=lax
