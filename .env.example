# Copie para .env (o .env real NUNCA vai para o GitHub)

# Servidor (API + Socket.IO)
PORT=3001

# Origem do frontend em dev (CORS)
WEB_ORIGIN=http://localhost:5173

# Segredo para assinar tokens de sessão. Gere um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo

# PostgreSQL (Neon): postgres://usuario:senha@host/banco?sslmode=require
DATABASE_URL=
